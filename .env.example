# Copy to .env.local and fill in. With no Stripe key the app runs in DEMO mode (payments simulated).

NEXT_PUBLIC_BASE_URL=http://localhost:3000   # production: https://ecotaxpay.com

# Branding. Each host sets their own name / business / tax number on their Account page.
BRAND_NAME=Eco Tax Pay

# Signs host login sessions. Required in production: a long random string (e.g. `openssl rand -hex 32`).
SESSION_SECRET=

# Stripe (https://dashboard.stripe.com/test/apikeys). Used for guest tax payments AND the €3/month host subscription.
# Webhook events: checkout.session.completed, checkout.session.async_payment_succeeded,
#                 customer.subscription.created, customer.subscription.updated, customer.subscription.deleted
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional service fee on top of the tax (0 = off)
SERVICE_FEE_FIXED_CENTS=0
SERVICE_FEE_PERCENT=0

# Email receipts via Resend (https://resend.com) — optional
RESEND_API_KEY=
EMAIL_FROM=Eco Tax Pay <receipts@ecotaxpay.com>

# WhatsApp receipts via WhatsApp Business Cloud API (Meta). Optional.
# Needs an approved template (header: DOCUMENT; body with {{1}} name, {{2}} amount, {{3}} receipt no.)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_RECEIPT_TEMPLATE=payment_receipt
WHATSAPP_TEMPLATE_LANG=en

# Optional: machine translation into ~130 more languages (Google Cloud Translation API key).
GOOGLE_TRANSLATE_API_KEY=

# The company behind the platform: shown on Contact, legal pages and schema markup.
COMPANY_LEGAL_NAME=Eco Tax Pay Ltd
COMPANY_ADDRESS=
SUPPORT_EMAIL=support@ecotaxpay.com
